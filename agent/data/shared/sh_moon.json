  "plan": {
    "theme_id": "sh_moon",
    "name": "月亮为什么跟着我",
    "domain": "自然",
    "level": 2,
    "goal": "愿意提出自己的猜想，并通过观察验证；知道月亮很远很远",
    "ideas": [
      {
        "idea": "很远的东西看起来不怎么动",
        "kid_words": "月亮离我们特别特别远，所以看起来一直在那里"
      },
      {
        "idea": "月亮每天的样子会变",
        "kid_words": "月亮有时候圆圆的，有时候弯弯的像香蕉"
      }
    ],
    "moves": [
      {
        "type": "猜一猜",
        "prompt": "你觉得月亮是真的在跟着我们走吗？"
      },
      {
        "type": "比一比",
        "prompt": "坐车的时候，看看路边的树和天上的月亮，谁跑得快？"
      },
      {
        "type": "找一找",
        "prompt": "这几天晚上和爸爸妈妈看看月亮，它的样子一样吗？"
      },
      {
        "type": "讲给我听",
        "prompt": "如果你能坐火箭去月亮上，你想做什么？"
      }
    ],
    "words": [
      {
