        "zh": "月亮",
        "difficulty": 1
      },
      {
        "en": "far",
        "zh": "远",
        "difficulty": 1
      },
      {
        "en": "round",
        "zh": "圆的",
        "difficulty": 2
      },
      {
        "en": "star",
        "zh": "星星",
        "difficulty": 1
      }
    ],
    "scene_hint": "晚上坐车、散步看到月亮、睡前",
    "avoid": "不讲引力、月相成因等超出年龄的概念，除非孩子追问"
