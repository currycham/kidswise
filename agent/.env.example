# ---- Waywise Agent ----
# 设备接入层（xiaozhi-esp32-server）调用本服务时带的 key，自己定一个
AGENT_API_KEY=change-me

# 对外暴露的模型名（xiaozhi 的 .config.yaml 里 model_name 填这个）
AGENT_MODEL_NAME=mumi-teacher

# ---- 主 LLM（任意 OpenAI 兼容接口）----
# provider=mock 时不调外部模型，用于本地联调
LLM_PROVIDER=mock
# 阿里百炼示例：
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=qwen-plus
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=8
LLM_MAX_TOKENS=150

# ---- 备 LLM（主挂了自动切，留空则不启用）----
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ---- 默认孩子档案（第 4 天接数据库前先用这个）----
DEFAULT_CHILD_NAME=小朋友
DEFAULT_CHILD_AGE=5
DEFAULT_THEME_ID=park

# ---- TTS：豆包语音合成 2.0（控制台页面底部的 APP ID / Access Token）----
TTS_APPID=
TTS_ACCESS_TOKEN=
# 音色，默认 Tina 老师（英语教学）
TTS_VOICE=zh_female_yingyujiaoxue_uranus_bigtts
