.wrap { display: flex; flex-direction: column; height: 100vh; }
.log { flex: 1; padding: 24rpx 32rpx; box-sizing: border-box; }
.intro { margin-bottom: 24rpx; }
.chips { display: flex; flex-direction: column; gap: 16rpx; }
.chip-q { background: var(--card); border: 2rpx solid var(--line); border-radius: 20rpx; padding: 20rpx 24rpx; font-size: 28rpx; }
.msg { margin-bottom: 24rpx; padding: 20rpx 26rpx; border-radius: 24rpx; line-height: 1.7; font-size: 30rpx; }
.msg.parent { background: var(--accent-soft); margin-left: 80rpx; }
.msg.advisor { background: var(--card); margin-right: 40rpx; }
.msg.thinking { color: var(--muted); }
.plan { margin-top: 16rpx; color: var(--accent); font-size: 26rpx; }
.bar { display: flex; align-items: flex-end; gap: 16rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); background: var(--card); border-top: 2rpx solid var(--line); }
.input { flex: 1; min-height: 72rpx; max-height: 240rpx; padding: 16rpx 20rpx; background: var(--bg); border-radius: 16rpx; font-size: 30rpx; }
.send { width: 120rpx; padding: 16rpx 0; }
.send.off { opacity: .5; }
