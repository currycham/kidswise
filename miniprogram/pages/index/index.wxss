.welcome { text-align: center; padding: 64rpx 40rpx; }
.welcome-title { font-size: 40rpx; font-weight: 600; margin-bottom: 16rpx; }
.welcome .btn { margin-top: 48rpx; }
.quote { background: linear-gradient(135deg, #FFF1E3, #FFFFFF); }
.quote-text { font-size: 40rpx; font-weight: 600; line-height: 1.45; }
.quote-time { margin-top: 16rpx; }
.alert { background: var(--alert-soft); }
.alert-head { color: var(--alert); font-weight: 600; margin-bottom: 8rpx; }
.stats { justify-content: space-around; text-align: center; }
.stat-num { font-size: 52rpx; font-weight: 700; color: var(--accent); }
.links { padding: 8rpx 8rpx 0; }
.link { color: var(--accent); }
.advisor-entry { border: 2rpx solid var(--accent); }
.advisor-title { font-size: 32rpx; font-weight: 600; margin-bottom: 6rpx; }

/* 切换孩子：家里有几个孩子时出现在顶部 */
.switcher { display: flex; align-items: center; gap: 8rpx; padding: 4rpx 8rpx 20rpx; }
.switcher-name { font-weight: 600; flex: 1; }
