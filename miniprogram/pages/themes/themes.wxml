<view class="page">
  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{error}}" class="error" bindtap="load">{{error}}，点击重试</view>

  <block wx:else>
    <!-- 说一句想法 → 北极星起草 -->
    <view class="card">
      <view class="ask-title">有个想法？说一句就行</view>
      <textarea class="idea" value="{{idea}}" auto-height maxlength="300" placeholder="比如：他老问天为什么会黑，想借这个让他知道地球在转" bindinput="onIdea" />
      <view class="row wrap examples">
        <view class="example" wx:for="{{examples}}" wx:key="*this" data-text="{{item}}" bindtap="useExample">{{item}}</view>
      </view>
      <view class="btn" bindtap="draft">让北极星起草</view>
    </view>

    <!-- 别的家长在做什么：按孩子最近的问题挑几个 -->
    <block wx:if="{{shared.length}}">
      <view class="section">别的家长在做什么</view>
      <view class="card shared" wx:for="{{shared}}" wx:key="id" data-id="{{item.id}}" bindtap="borrow">
        <view class="row between">
          <view class="theme-name">{{item.name}}</view>
          <view class="small accent">借用 ›</view>
        </view>
        <view class="small reason" wx:if="{{item.reason}}">{{item.reason}}</view>
        <view class="muted small">{{item.goal}}</view>
        <view class="muted small quote" wx:if="{{item.reaction}}">{{item.author}}：{{item.reaction}}</view>
      </view>
    </block>

    <view class="section">{{child ? child.name + '的计划和主题' : '计划和主题'}}</view>
    <view class="muted small intro" wx:if="{{child}}">点一下可以切换{{child.name}}现在在玩的</view>
    <view class="muted small intro" wx:else>绑定设备后可以给孩子选</view>

    <view class="card theme {{child && item.id === child.theme_id ? 'current' : ''}}" wx:for="{{themes}}" wx:key="id" data-theme="{{item}}" bindtap="choose">
      <view class="row between">
        <view class="theme-name">{{item.name}}<text class="mine" wx:if="{{item.custom}}">我做的</text></view>
        <view class="small current-tag" wx:if="{{child && item.id === child.theme_id}}">正在玩</view>
        <view class="small muted" wx:else>{{item.domain}}</view>
      </view>
      <view class="muted small">{{item.sampleText}}</view>
    </view>

    <view class="card studio">
      <view class="studio-title">想逐条细调？</view>
      <view class="muted small">在电脑上打开 <text class="url">waywise.tech/studio</text>，输入下面的登录码，可以改每一个要点、动作和词。</view>
      <view wx:if="{{loginCode}}" class="login-code">{{loginCode}}</view>
      <view wx:if="{{loginCode}}" class="muted small">5 分钟内有效，只能用一次</view>
      <view class="btn ghost code-btn" bindtap="getLoginCode">{{loginCode ? '换一个登录码' : '获取电脑登录码'}}</view>
    </view>
  </block>
</view>
