<view class="page">
  <view class="card" wx:if="{{child}}">
    <view class="card-title">孩子信息</view>
    <view class="field">
      <text class="label">昵称</text>
      <input class="input" value="{{name}}" placeholder="Mumi 会这样称呼孩子" maxlength="12" bindinput="onNameInput" />
    </view>
    <view class="field">
      <text class="label">年龄</text>
      <picker range="{{AGES}}" value="{{ageIndex}}" bindchange="onAgeChange">
        <view class="input">{{AGES[ageIndex]}} 岁 ›</view>
      </picker>
    </view>
    <view class="muted small hint">年龄决定 Mumi 说英文的比例：4 岁以下以中文为主，6 岁以上以英文为主。</view>
    <view class="btn" bindtap="save">保存</view>
  </view>

  <view class="card">
    <view class="card-title">{{child ? '已绑定的设备' : '绑定设备'}}</view>
    <block wx:if="{{child}}">
      <view class="muted small device" wx:for="{{child.devices}}" wx:key="*this">{{item}}</view>
    </block>
    <view class="muted small hint" wx:if="{{!child}}">扫描 Mumi 附带卡片上的二维码，或者手动输入卡片上的设备码。</view>
    <view class="field">
      <input class="input" value="{{deviceId}}" placeholder="设备码" bindinput="onDeviceInput" />
      <text class="scan" bindtap="scan">扫码</text>
    </view>
    <view class="btn {{child ? 'ghost' : ''}}" bindtap="bind">{{child ? '再绑定一台' : '绑定'}}</view>
  </view>

  <view class="card" wx:if="{{child}}">
    <view class="card-title">木米的眼睛</view>
    <view class="field">
      <text class="label wide">让木米看东西</text>
      <switch checked="{{vision}}" bindchange="toggleVision" />
    </view>
    <view class="muted small hint">打开时，孩子说「你看这是什么」，木米会拍一张来理解，照片不保存。关掉后木米不再拍照，仍然能陪孩子聊天。</view>
    <view class="sub-title">最近 30 天看过什么</view>
    <view class="muted small" wx:if="{{!seen.length}}">还没有。</view>
    <view class="seen" wx:for="{{seen}}" wx:key="created_at">
      <view class="muted small">{{item.time}} · 孩子说「{{item.asked}}」</view>
      <view class="seen-text">{{item.seen}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{child}}">
    <view class="card-title">数据</view>
    <view class="muted small hint">导出：在电脑上打开 waywise.tech/studio，点「导出数据」。</view>
    <view class="btn ghost danger" bindtap="deleteData">删除{{child.name}}的全部数据</view>
  </view>

  <view class="error" wx:if="{{error}}">{{error}}</view>
</view>
