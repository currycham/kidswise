# KidsWise 的 Caddy 配置，由 deploy/server_deploy.sh 装到 /etc/caddy/kidswise.caddy。
# 主 /etc/caddy/Caddyfile 只是各产品 *.caddy 的 import 列表，归 waywise_project/ops/caddy 管，这里不碰它
# api.waywise.tech：家长端小程序 / 开发者平台访问 agent 的入口
# Caddy 自动申请并续期 HTTPS 证书（Let's Encrypt）。原默认配置备份在 Caddyfile.orig
api.waywise.tech {
	encode gzip

	# 只暴露外部需要的路径；/v1/chat/completions 只给服务器内部的 xiaozhi 用
	handle /healthz {
		reverse_proxy 127.0.0.1:8080
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		respond 404
	}
}

# kidswise.waywise.tech：KidsWise 开发者平台（/studio）。/api 同域转给 agent，页面不用跨域
# studio 静态页目录 /var/www/waywise-studio 是历史命名，见 README「历史命名」
kidswise.waywise.tech {
	encode gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	redir /studio /studio/
	handle_path /studio/* {
		root * /var/www/waywise-studio
		file_server
	}
	handle {
		redir * /studio/ 302
	}
}

# waywise.tech（总品牌主页，含旧地址 /studio 的跳转）由 waywise_project/home 部署为 /etc/caddy/waywise.caddy
