# api.waywise.tech：家长端小程序 / 开发者平台访问 agent 的入口
# Caddy 自动申请并续期 HTTPS 证书（Let's Encrypt）。原默认配置备份在 Caddyfile.orig
api.waywise.tech {
	encode gzip

	# 只暴露外部需要的路径；/v1/chat/completions 只给服务器内部的 xiaozhi 用
	handle /healthz {
		reverse_proxy 127.0.0.1:8080
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		respond 404
	}
}

# kidswise.waywise.tech：KidsWise 开发者平台（/studio）。/api 同域转给 agent，页面不用跨域
# studio 静态页目录 /var/www/waywise-studio 是历史命名，见 README「历史命名」
kidswise.waywise.tech {
	encode gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	redir /studio /studio/
	handle_path /studio/* {
		root * /var/www/waywise-studio
		file_server
	}
	handle {
		redir * /studio/ 302
	}
}

# waywise.tech：Waywise 总品牌的域名，首页还没做。
# 旧版小程序里写的是 waywise.tech/studio，先整体跳到 KidsWise studio
waywise.tech, www.waywise.tech {
	handle /api/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle_path /studio/* {
		redir * https://kidswise.waywise.tech/studio{uri} 301
	}
	handle {
		redir * https://kidswise.waywise.tech/studio/ 302
	}
}
