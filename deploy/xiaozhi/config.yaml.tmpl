# xiaozhi-esp32-server 覆盖配置。只写和默认 config.yaml 不同的项。
# 由 deploy.sh 渲染：__PUBLIC_HOST__ / __AGENT_API_KEY__ / __TTS_*__ 会被替换。
server:
  websocket: ws://__PUBLIC_HOST__:8000/xiaozhi/v1/
  vision_explain: http://__PUBLIC_HOST__:8003/mcp/vision/explain
  timezone_offset: +8

# 人设在 Waywise agent 里。xiaozhi 的 system prompt 只用来带设备 ID：
# 模板只渲染出 <waywise-device id="..."/>，agent 解析后丢弃其余内容。
prompt: |
  你是 Mumi。
prompt_template: data/waywise-prompt.txt
system_error_response: "Mumi 有点累了，我们等一下再聊好吗？"

# 结束语会被当成一条 user 消息发给 agent，先关掉
end_prompt:
  enable: false

selected_module:
  VAD: SileroVAD
  ASR: Qwen3ASRFlash   # 2026-09-26 用 153 句真实儿童录音对比后选定；出问题可改回 FunASR（本地 SenseVoice）
  LLM: WaywiseAgent
  TTS: DoubaoTTS2   # 出问题时改回 EdgeTTS（免费，但首包 1–2 秒）
  Memory: nomem       # 记忆在 agent 里做
  Intent: nointent    # 不要 xiaozhi 的工具调用（放音乐、查天气等）

LLM:
  WaywiseAgent:
    type: openai
    base_url: http://agent:8080/v1
    model_name: mumi-teacher
    api_key: __AGENT_API_KEY__
    timeout:
      connect: 3
      read: 15

ASR:
  # 真实儿童录音对比（agent/eval/ASR.md）：中文差异 5.1%（SenseVoice 8.3%），英文 25.3%（29.3%），
  # 短句如「画画」「狗狗」明显更准；每句多约 0.26 秒。加词表 context 没有提升，不加。
  Qwen3ASRFlash:
    type: qwen3_asr_flash
    api_key: __ASR_API_KEY__
    base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
    model_name: qwen3-asr-flash
    output_dir: tmp/
    enable_lid: true
    enable_itn: true
    context: ""

TTS:
  # 豆包语音合成 2.0，双向流式，首包实测约 0.4–0.5 秒
  DoubaoTTS2:
    type: huoshan_double_stream
    ws_url: wss://openspeech.bytedance.com/api/v3/tts/bidirection
    appid: __TTS_APPID__
    access_token: __TTS_ACCESS_TOKEN__
    resource_id: seed-tts-2.0
    speaker: __TTS_VOICE__
    enable_ws_reuse: True
    audio_params:
      speech_rate: -10   # 给孩子听，稍慢一点
      loudness_rate: 0
    additions:
      post_process:
        pitch: 0
  EdgeTTS:
    type: edge
    voice: zh-CN-XiaoxiaoNeural
    output_dir: tmp/
